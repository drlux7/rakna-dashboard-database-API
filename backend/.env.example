# Rakna Backend Environment Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration
# For local SQLite:
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rakna_db?schema=public"

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# Uploads & Storage
UPLOAD_DIR=./uploads

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5000

# WhatsApp Integration (Optional Meta Cloud API)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
